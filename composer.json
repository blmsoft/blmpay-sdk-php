{
  "name": "blmsoft/blmpay-php",
  "description": "Official PHP SDK for the BLMPay REST API with domain-bound API key support",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "blmpay",
    "payments",
    "payment-gateway",
    "mobile-money",
    "payouts",
    "tanzania",
    "api",
    "sdk"
  ],
  "homepage": "https://github.com/Winnie7676/blmpay-sdk-php",
  "authors": [
    {
      "name": "BLMSoft",
      "homepage": "https://blmtec.co.tz"
    }
  ],
  "support": {
    "issues": "https://github.com/Winnie7676/blmpay-sdk-php/issues",
    "source": "https://github.com/Winnie7676/blmpay-sdk-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "BLMSoft\\BLMPay\\": "src/BLMSoft/BLMPay/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.2.x-dev"
    }
  }
}
